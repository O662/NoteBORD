<?xml version="1.0" encoding="utf-8"?>
<!-- Recordings play from memory through just_audio's proxy on this device
     (http://127.0.0.1:…), so a locked page's audio is never written out in
     the clear. Plain HTTP is allowed to this device only; everything else
     stays HTTPS-only (Android's default). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
